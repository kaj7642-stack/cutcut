{
  "name": "cutcut",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=22.5.0"
  },
  "scripts": {
    "dev": "next dev --port 3100",
    "build": "next build",
    "start": "next start --port 3100",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "pipeline:episode": "tsx scripts/run-episode.mts",
    "pipeline:render": "tsx scripts/render-episode.mts",
    "pipeline:auth": "node scripts/youtube-auth.mjs",
    "remotion:studio": "remotion studio remotion/index.ts --public-dir=output",
    "verify": "tsx scripts/verify-pipeline.mts",
    "lint:pipeline": "eslint lib/pipeline lib/prompts remotion scripts tests app/api/generate-episode"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.115.0",
    "@remotion/bundler": "^4.0.520",
    "@remotion/cli": "^4.0.520",
    "@remotion/player": "^4.0.520",
    "@remotion/renderer": "^4.0.520",
    "next": "^16.3.0",
    "pg": "^8.23.0",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "remotion": "^4.0.520",
    "uuid": "^11.1.0",
    "zod": "^4.5.4"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "^26.1.1",
    "@types/pg": "^8.21.0",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@types/uuid": "^10",
    "eslint": "^9",
    "eslint-config-next": "^16.3.0",
    "tailwindcss": "^4",
    "tsx": "^4.23.13",
    "typescript": "^5",
    "vitest": "^4.1.11"
  }
}
