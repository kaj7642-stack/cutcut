# ─────────────────────────────────────────────────────────────
# 가상 전쟁 스토리 유튜브 자동화 파이프라인
# 이 파일을 .env.local로 복사한 뒤 값을 채우세요.
# ─────────────────────────────────────────────────────────────

# ── LLM (1·2·3·4단계 대본/프롬프트 생성) ────────────────────
ANTHROPIC_API_KEY=
# 선택: 기본값 claude-sonnet-4-6
PIPELINE_LLM_MODEL=

# ── 이미지 생성 (3단계) ─────────────────────────────────────
# openai | stability | mock (미지정 시 키를 보고 자동 선택)
IMAGE_PROVIDER=
OPENAI_API_KEY=
# 선택: 기본값 gpt-image-1
OPENAI_IMAGE_MODEL=
STABILITY_API_KEY=
# 선택: 기본값 sd3.5-large
STABILITY_MODEL=

# ── TTS (4단계) ─────────────────────────────────────────────
# openai | google | mock (미지정 시 키를 보고 자동 선택)
TTS_PROVIDER=
# OPENAI_API_KEY를 그대로 사용
# 선택: 기본값 gpt-4o-mini-tts
OPENAI_TTS_MODEL=
GOOGLE_TTS_API_KEY=
# 선택: 내레이터/캐릭터 기본 보이스
PIPELINE_NARRATOR_VOICE=
PIPELINE_CHARACTER_VOICE=
# 선택: speaker_id → 보이스 매핑 JSON
# 예) {"narrator":"fable","character:이레네 볼크":"nova"}
PIPELINE_VOICE_MAP=

# ── 영상 조립 (5단계) ───────────────────────────────────────
# auto(기본) | remotion | ffmpeg
PIPELINE_RENDERER=
# 선택: Remotion이 쓸 Chrome/Chromium 실행 파일 경로
REMOTION_BROWSER_EXECUTABLE=
# 선택: ffmpeg / ffprobe 실행 파일 경로 (PATH에 없을 때)
FFMPEG_PATH=
FFPROBE_PATH=
# 선택: 직접 준비한 BGM 디렉터리 (tense/hype/calm/bright.mp3)
# 없으면 절차적으로 합성한 트랙을 사용합니다.
PIPELINE_BGM_DIR=

# ── 유튜브 업로드 (6단계) ───────────────────────────────────
# Google Cloud Console > OAuth 클라이언트(데스크톱 앱)에서 발급
YOUTUBE_CLIENT_ID=
YOUTUBE_CLIENT_SECRET=
# node scripts/youtube-auth.mjs 로 최초 1회 인증 후 발급받은 값
YOUTUBE_REFRESH_TOKEN=
# 선택: 기본값 http://localhost:8787
YOUTUBE_REDIRECT_URI=
# 선택: 기본값 24 (Entertainment)
YOUTUBE_CATEGORY_ID=

# ── 저장 경로 (선택) ────────────────────────────────────────
PIPELINE_DATA_DIR=
PIPELINE_OUTPUT_DIR=

# ── 검증/오프라인 모드 ──────────────────────────────────────
# 1로 두면 외부 API 없이 mock 프로바이더로 파이프라인 전체를 실행합니다.
PIPELINE_MOCK=

# ── 기존 cutcut 앱에서 쓰는 값 ──────────────────────────────
DATABASE_URL=
WORK_DIR=
